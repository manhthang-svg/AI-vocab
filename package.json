{
  "name": "milim",
  "version": "3.6.1",
  "description": "A gentle, local-first English vocabulary companion.",
  "main": "main.js",
  "author": "milim",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check local-ai.js && node --check preload.js && node --check src/ai-contract.js && node --check src/grading.js && node --check src/tree.js && node --check src/app.js",
    "test": "node --test tests/*.test.js",
    "dist": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.milim.vocab",
    "productName": "milim",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "main.js",
      "local-ai.js",
      "preload.js",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "milim"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "manhthang-svg",
        "repo": "AI-vocab",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "ts-fsrs": "^5.4.1"
  }
}
